##################################################################################################
#
# Main -> OnlineMenu
#
##################################################################################################
screen   OnlineMenu Main

keyValue
    value    		String sys 0x00000000 0
    label    		"[Online Menu v1.7]"
    poll     		0

keyValue
    value    		String sys 0x00000000 0
    label    		""
    poll     		0	
	
##################################################################################################
#
# Main -> OnlineMenu -> Scripts
#
##################################################################################################
screen  Scripts OnlineMenu

script
   value    		sys 1 0x0100 "/scripts/online/check_online_setup.sh"
   label    		"Check online setup (read only)"

script
   value    		sys 1 0x0100 "/scripts/online/setup_online.sh"
   label    		"Configure online services (server-ip.txt)"

script
   value    		sys 1 0x0100 "/scripts/online/restore_online_setup.sh"
   label    		"Restore online setup backups"

script
   value    		sys 1 0x0100 "/scripts/online/dump_info.sh"
   label    		"Show and save FAZIT and more"

keyValue
    value    		String sys 0x00000000 0
    label    		""
    poll     		0	
	
script
   value    		sys 1 0x0100 "/scripts/online/dump_here_certificates.sh"
   label    		"Dump HERE CA certificates to SD (read only)"

script
   value    		sys 1 0x0100 "/scripts/online/check_here_certificates.sh"
   label    		"Check missing HTTPS roots (read only)"

script
   value    		sys 1 0x0100 "/scripts/online/import_here_certificates.sh"
   label    		"Add missing HTTPS roots (keep this car certificates)"

script
   value    		sys 1 0x0100 "/scripts/online/restore_here_certificates.sh"
   label    		"Restore CA backup / remove added override"

script
   value    		sys 1 0x0100 "/scripts/online/nosslcheck.sh"
   label    		"Check SSL status for online services"

script
   value    		sys 1 0x0100 "/scripts/online/set_nosslcheck.sh"
   label    		"Disable SSL check for online services"
   
script
   value    		sys 1 0x0100 "/scripts/online/unset_nosslcheck.sh"
   label    		"Re-enable SSL check for online services"

keyValue
    value    		String sys 0x00000000 0
    label    		""
    poll     		0	
	
script
   value    		sys 1 0x0100 "/scripts/online/dump_hosts.sh"
   label    		"Dump hosts file"
   
script
   value    		sys 1 0x0100 "/scripts/online/import_hosts.sh"
   label    		"Import new hosts file from online/hosts folder (hosts.txt)"  
   
keyValue
    value    		String sys 0x00000000 0
    label    		""
    poll     		0	
   
script
   value    		sys 1 0x0100 "/scripts/online/dump_libP.sh"
   label    		"Dump /net/mmx/mnt/app/navigation/libPresentationController.so"
   
script
   value    		sys 1 0x0100 "/scripts/online/import_libP.sh"
   label    		"Import new libPresentationController.so from online/libPres... folder"

keyValue
    value    		String sys 0x00000000 0
    label    		""
    poll     		0	
	
script
   value    		sys 1 0x0100 "/scripts/online/dump_remotehmi.sh"
   label    		"Dump /net/mmx/mnt/app/eso/hmi/remotehmi"
   
script
   value    		sys 1 0x0100 "/scripts/online/dump_rhmi.sh"
   label    		"Dump /var/app/rhmi"
   
script
   value    		sys 1 0x0100 "/scripts/online/dump_credentials.sh"
   label    		"Dump /ramdisk/credentials"

keyValue
    value    		String sys 0x00000000 0
    label    		""
    poll     		0	
	
button
	value   		per 0 1 ""
    label   		"Flush persistence cache to FFS"

script
   value    		sys 1 0x0100 "/scripts/performePersReset.sh"
   label    		"Require reset with persistence"

##################################################################################################
#
# Main -> OnlineMenu -> Coding
#
##################################################################################################
screen  Coding OnlineMenu

keyValue
    value    		String sys 0x00000000 0
    label    		"If your car never had online services you need to code them. Choose Reboot"
    poll     		0
	
keyValue
    value    		String sys 0x00000000 0
    label    		"button at the bottom of this site afterwards to save changes."
    poll     		0

keyValue	
	value 			String per 1 0x00010003
    label 			"_____________________________________________________________________________"
    poll     		500


keyValue
    value    		String sys 0x00000000 0
    label    		"PayTMC should be set to either 32785 (RUS) or 32783 (EU). Also see readme!"
    poll     		0

slider
    value       	per 28442848 520
	label       	"Set PayTMC (coarse)"
	limits			absolute 0 65535 200
    poll        	1000
	
slider
    value       	per 28442848 531
	label       	"Set PayTMC (fine)"
	limits			absolute 0 65535
    poll        	1000
	
keyValue
    value    		String sys 0x00000000 0
    label    		""
    poll     		0

keyValue
    value    		String sys 0x00000000 0
    label    		"You also need to change adaptation channels. Not all is neccessary"
    poll     		0
	
keyValue
    value    		String sys 0x00000000 0
    label    		"and differs between brands. Check readme."
    poll     		0
	
