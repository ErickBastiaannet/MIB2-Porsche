##################################################################################################
#
# Main -> OnlineMenu -> Update/Uninstall/...
#
##################################################################################################
screen "Update/Uninstall/..." OnlineMenu	
	
button
	value 			per 1501 10 PurgePersistence
	label 			"Purge OLS Persistence"
	poll 			500	

script
   value    		sys 1 0x0100 "/eso/hmi/engdefs/scripts/online/update.sh"
   label    		"Update OnlineMenu and scripts"
   
script
   value    		sys 1 0x0100 "/eso/hmi/engdefs/scripts/online/clean_log.sh"
   label    		"Clean update log"
	
script
   value    		sys 1 0x0100 "/eso/hmi/engdefs/scripts/online/uninstall_dev.sh"
   label    		"Uninstall OnlineMenu and disable Devmode (undo codings yourself before!)"
   
script
   value    		sys 1 0x0100 "/eso/hmi/engdefs/scripts/online/uninstall.sh"
   label    		"Uninstall OnlineMenu and keep Devmode (undo codings yourself before!)"
